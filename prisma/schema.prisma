// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id              Int       @id @default(autoincrement())
  title           String
  completed       Boolean   @default(false) // one-off tasks only (dueDate set)
  priority        String    @default("Medium") // "High" | "Medium" | "Low"
  dueDate         DateTime? // null = daily recurring task, set = one-off task
  dailyCount      Int       @default(0) // daily recurring tasks only: lifetime completion count
  lastCompletedAt DateTime? // daily recurring tasks only: last time checked done
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
